
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    card_view:cardCornerRadius="13dp"
    card_view:cardUseCompatPadding="true"
    android:layout_margin="12dp">

<androidx.core.widget.NestedScrollView
    android:id="@+id/nested_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:descendantFocusability="beforeDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="10dp">

    <TextView
        android:id="@+id/nombre_tienda"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/gris"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"/>

    <LinearLayout
        android:id="@+id/layout_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#F0F4F8"
        android:padding="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_total_porcentaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total: 0.0%"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/tv_rango_cumplimiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rango: BAJO"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_acta_entrega"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8F9FA"
        android:padding="14dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acta de Entrega de Visita"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre de quien recibe la visita *"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/gris"
            android:layout_marginBottom="4dp" />

        <AutoCompleteTextView
            android:id="@+id/et_nombre_recibe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_signature_box"
            android:padding="10dp"
            android:hint="Escriba o seleccione colaborador..."
            android:textSize="14sp"
            android:inputType="textCapWords"
            android:completionThreshold="1"
            android:dropDownHeight="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cargo de quien recibe"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/gris"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_cargo_recibe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_signature_box"
            android:padding="10dp"
            android:hint="Cargo en tienda (ej. Administrador, Artesano...)"
            android:textSize="14sp"
            android:inputType="textCapWords"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medidas correctivas recomendadas"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/gris"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_medidas_correctivas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_signature_box"
            android:padding="10dp"
            android:hint="Observaciones o medidas a implementar..."
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top|start"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Firma de quien recibe la visita *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/gris" />

            <Button
                android:id="@+id/btn_limpiar_firma"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Limpiar"
                android:textSize="12sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:backgroundTint="#757575"
                android:textColor="@color/white" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_signature_box"
            android:padding="4dp">

            <com.example.appoperaciones.Clases.SignatureView
                android:id="@+id/signature_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Firme con el dedo dentro del recuadro"
            android:textSize="11sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Firma de quien realiza la inspección *"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/gris" />

            <Button
                android:id="@+id/btn_limpiar_firma_inspector"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Limpiar"
                android:textSize="12sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:backgroundTint="#757575"
                android:textColor="@color/white" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/bg_signature_box"
            android:padding="4dp">

            <com.example.appoperaciones.Clases.SignatureView
                android:id="@+id/signature_view_inspector"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Firma del inspector/auditor"
            android:textSize="11sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <Button
        android:layout_marginTop="10dp"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Enviar respuesta"
        android:textColor="@color/white"
        android:id="@+id/enviarEncuesta"/>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
</androidx.cardview.widget.CardView>