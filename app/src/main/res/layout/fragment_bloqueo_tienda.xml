<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="13dp"
    card_view:cardUseCompatPadding="true"
    android:layout_margin="15dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:padding="15dp"
       >
       <TextView
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="Actualizacion de estado"
           android:layout_marginTop="5dp"
           android:gravity="center"
           android:textSize="18sp"
           android:background="@color/colorPrimary"
           android:textStyle="bold"
           android:textColor="@color/white">

       </TextView>
       <TextView
           android:layout_marginTop="10dp"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="Evento"
           android:textSize="18sp"
           android:textStyle="bold"
           android:textColor="@color/black"/>
       <Spinner
           android:id="@+id/tipoevento"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="8dp"
           android:entries="@array/tipoevento"/>
       <TextView
           android:layout_marginTop="10dp"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="Tienda"
           android:textSize="18sp"
           android:textStyle="bold"
           android:textColor="@color/black"/>

       <Spinner
           android:id="@+id/tiendas"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="8dp"
          />
       <LinearLayout
           android:id="@+id/opciones_bloq"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical">
       <TextView
           android:layout_marginTop="8dp"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="observacion"
           android:textSize="18sp"
           android:textStyle="bold"
           android:textColor="@color/black"/>
        <EditText
            android:id="@+id/observacion"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        </EditText>

       <TextView
           android:layout_marginTop="8dp"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="Motivo"
           android:textSize="18sp"
           android:textStyle="bold"
           android:textColor="@color/black"/>

       <Spinner
           android:id="@+id/motivo"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="8dp"
           android:entries="@array/motivo"/>
       <TextView
           android:layout_marginTop="8dp"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="Desbloqueo en"
           android:textSize="18sp"
           android:textStyle="bold"
           android:textColor="@color/black"/>
       <Spinner
           android:id="@+id/Desbloqueo"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="8dp"
           android:entries="@array/Desbloqueo"/>

       <TextView
           android:layout_marginTop="10dp"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="Canales a bloquear"
           android:textSize="18sp"
           android:textStyle="bold"
           android:textColor="@color/black"/>

       <CheckBox
           android:id="@+id/chk_canal_todos"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="Todos los canales (General)"
           android:checked="true"
           android:textSize="15sp"
           android:layout_marginTop="4dp"/>

       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical"
           android:layout_marginLeft="16dp">

           <CheckBox
               android:id="@+id/chk_canal_bot"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:text="Bot WhatsApp"
               android:checked="true"
               android:enabled="false"
               android:textSize="14sp"/>

           <CheckBox
               android:id="@+id/chk_canal_tienda_virtual"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:text="Tienda Virtual (Web)"
               android:checked="true"
               android:enabled="false"
               android:textSize="14sp"/>

           <CheckBox
               android:id="@+id/chk_canal_call_center"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:text="Call Center"
               android:checked="true"
               android:enabled="false"
               android:textSize="14sp"/>

           <CheckBox
               android:id="@+id/chk_canal_pos"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:text="POS (Caja en tienda)"
               android:checked="true"
               android:enabled="false"
               android:textSize="14sp"/>
       </LinearLayout>

       </LinearLayout>
<Button
    android:id="@+id/guardar"
    android:layout_marginTop="15dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Guardar Cambios"
    android:layout_gravity="center"
    android:textColor="@color/white"
    >


</Button>
   </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>

