<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="13dp"
    card_view:cardUseCompatPadding="true">



        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:paddingTop="8dp">

            <ImageView
                android:id="@+id/id_img"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="5dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_baseline_ballot_24"
                android:tint="@color/verde"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/id_img"
                android:orientation="vertical"
                android:padding="5dp">
                <TextView
                    android:id="@+id/fechahora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/nombre"
                    android:layout_alignLeft="@+id/nombre"
                    android:text="fechahora"
                    android:textColor="@color/black"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/nombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre"

                     />


                <TextView
                    android:id="@+id/tipoencuesta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="tipoencuesta" />

                <TextView
                    android:id="@+id/porcentaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="porcentaje" />

            </LinearLayout>
        </RelativeLayout>

</androidx.cardview.widget.CardView>
